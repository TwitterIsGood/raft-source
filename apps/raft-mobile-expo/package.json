{
  "name": "@raft/mobile-expo",
  "version": "0.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "EXPO_NO_METRO_WORKSPACE_ROOT=1 expo start",
    "ios": "EXPO_NO_METRO_WORKSPACE_ROOT=1 expo run:ios",
    "prebuild": "expo prebuild --platform ios",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/messageCache.test.mjs",
    "android": "expo run:android"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/native": "^7.1.18",
    "expo": "~54.0.30",
    "expo-constants": "~18.0.12",
    "expo-device": "~8.0.10",
    "expo-notifications": "~0.32.16",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@types/react": "~19.1.13",
    "typescript": "~5.9.2"
  }
}
